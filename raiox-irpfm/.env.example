# Copy to apps/web/.env.local (Next.js) and adjust. Never commit real values.
DATABASE_URL=postgres://raiox:raiox_dev_only@localhost:5432/raiox
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (used in invitation links and cookies).
BETTER_AUTH_URL=http://localhost:3000
# Tests (apps/web) use a separate database that they drop and recreate.
DATABASE_URL_TEST=postgres://raiox:raiox_dev_only@localhost:5432/raiox_test
# Phase 4: AI messages. The model is configured here, never in the code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
